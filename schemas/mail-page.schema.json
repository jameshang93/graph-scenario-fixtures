{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mail-page",
  "type": "object",
  "required": ["@odata.context", "@odata.nextLink", "value"],
  "properties": {
    "@odata.context": { "type": "string" },
    "@odata.nextLink": { "type": "string" },
    "value": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "subject"],
        "properties": {
          "id": { "type": "string" },
          "subject": { "type": "string" },
          "bodyPreview": { "type": "string" },
          "receivedDateTime": { "type": "string" },
          "from": {
            "type": "object",
            "properties": {
              "emailAddress": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "address": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
