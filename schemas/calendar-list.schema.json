{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "calendar-list",
  "type": "object",
  "required": ["@odata.context", "value"],
  "properties": {
    "@odata.context": { "type": "string" },
    "value": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "color": { "type": "string" },
          "changeKey": { "type": "string" },
          "canShare": { "type": "boolean" },
          "canViewPrivateItems": { "type": "boolean" },
          "canEdit": { "type": "boolean" },
          "owner": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "address": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
