{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "teams-chat-message",
  "type": "object",
  "required": ["@odata.context", "value"],
  "properties": {
    "@odata.context": { "type": "string" },
    "value": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "chatId", "messageType", "body", "from"],
        "properties": {
          "id": { "type": "string" },
          "chatId": { "type": "string" },
          "messageType": { "type": "string" },
          "body": {
            "type": "object",
            "required": ["contentType", "content"],
            "properties": {
              "contentType": { "type": "string" },
              "content": { "type": "string" }
            }
          },
          "from": {
            "type": "object",
            "required": ["user"],
            "properties": {
              "user": {
                "type": "object",
                "required": ["displayName", "userIdentityType"],
                "properties": {
                  "displayName": { "type": "string" },
                  "userIdentityType": { "type": "string" }
                }
              }
            }
          }
        }
      }
    }
  }
}
